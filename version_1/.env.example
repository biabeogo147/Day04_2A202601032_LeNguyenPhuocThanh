# Day04 Version 1 — OpenAI is the default provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Gemini adapter
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

APP_DATABASE_URL=sqlite+aiosqlite:///./version_1/storage/app.db
CHECKPOINT_DATABASE_PATH=./version_1/storage/checkpoints.db
CHROMA_PERSIST_DIRECTORY=./version_1/storage/chroma
DATASET_PATH=./shared_data/DataTPCN.csv
